# Dependencies
node_modules/

# Build output
out/
dist/
# ...except hand-written test fixtures that must ship as they are.
!apps/desktop/e2e/fixtures/extensions/*/dist/
release/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/
blob-report/

# Local environment and secrets (never commit)
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Scanner output (e.g. gitleaks in CI)
*.sarif

# Built example extensions (pnpm build:examples)
examples/extensions/*/dist/
examples/extensions/dist/
