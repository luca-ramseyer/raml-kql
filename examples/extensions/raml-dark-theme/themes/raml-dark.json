{
  "name": "Raml Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#2bb5a3",
    "foreground": "#c9d1d9",
    "editor.background": "#0f1a1e",
    "editor.foreground": "#d4dde2",
    "editorLineNumber.foreground": "#4b6570",
    "editorLineNumber.activeForeground": "#9fc9c1",
    "editor.selectionBackground": "#1f5c5566",
    "editorCursor.foreground": "#2bb5a3",
    "activityBar.background": "#0b1417",
    "activityBar.foreground": "#d4dde2",
    "activityBar.inactiveForeground": "#6b8791",
    "activityBar.activeBorder": "#2bb5a3",
    "activityBarBadge.background": "#2bb5a3",
    "activityBarBadge.foreground": "#0b1417",
    "sideBar.background": "#0d171a",
    "sideBar.border": "#1b2a2f",
    "sideBarSectionHeader.background": "#0d171a",
    "titleBar.activeBackground": "#0b1417",
    "titleBar.activeForeground": "#c9d1d9",
    "statusBar.background": "#0b1417",
    "statusBar.foreground": "#9fb3ba",
    "statusBar.border": "#1b2a2f",
    "panel.background": "#0d171a",
    "panel.border": "#1b2a2f",
    "panelTitle.activeBorder": "#2bb5a3",
    "tab.activeBackground": "#0f1a1e",
    "tab.inactiveBackground": "#0b1417",
    "tab.activeBorderTop": "#2bb5a3",
    "editorGroupHeader.tabsBackground": "#0b1417",
    "button.background": "#1f8a7c",
    "button.hoverBackground": "#23a090",
    "button.foreground": "#ffffff",
    "input.background": "#0b1417",
    "input.border": "#24363c",
    "list.activeSelectionBackground": "#1f5c55",
    "list.hoverBackground": "#15262b",
    "list.inactiveSelectionBackground": "#172b30",
    "badge.background": "#1f5c55",
    "charts.blue": "#2bb5a3",
    "textLink.foreground": "#4fd1bf"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#5f7d86", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#4fd1bf" } },
    { "scope": ["string"], "settings": { "foreground": "#e3b873" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#b6d98c" } },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#8ab4f8" }
    }
  ]
}
