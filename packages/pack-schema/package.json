{
  "name": "@raml-kql/pack-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas (zod + JSON Schema) for Raml KQL query packs and extension manifests.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./kql-literal": "./src/kql-literal.ts",
    "./schemas/*.json": "./schemas/*.json",
    "./extension-manifest": "./src/extension-manifest.ts",
    "./semver": "./src/semver.ts",
    "./extension-signature": "./src/extension-signature.ts",
    "./extension-catalog": "./src/extension-catalog.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "cd ../.. && RKQL_UPDATE_SCHEMAS=1 vitest run packages/pack-schema/src/json-schema.test.ts"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "files": [
    "src",
    "schemas"
  ]
}
