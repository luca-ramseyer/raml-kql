{
  "name": "@raml-kql/extension-cli",
  "version": "0.0.0",
  "private": true,
  "description": "raml-kql-ext: scaffold, validate and package Raml KQL extensions.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/cli.cjs --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "@raml-kql/pack-schema": "workspace:*",
    "fflate": "0.8.3"
  },
  "bin": {
    "raml-kql-ext": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ]
}
