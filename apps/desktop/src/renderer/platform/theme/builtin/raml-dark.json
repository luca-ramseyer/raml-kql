  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#948C7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#BAC47E"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant", "constant.language"],
      "settings": {
        "foreground": "#E3B272"
      }
    },
    {
      "name": "Keywords and query operators",
      "scope": ["keyword", "keyword.control", "storage"],
      "settings": {
        "foreground": "#E5877B"
      }
    },
    {
      "name": "Directives",
      "scope": ["keyword.control.directive", "meta.preprocessor"],
      "settings": {
        "foreground": "#E5877B"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#E8E1D3"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#8FBAC6"
      }
    },
    {
      "name": "Types",
      "scope": ["storage.type", "support.type"],
      "settings": {
        "foreground": "#BCAAD8"
      }
    },
    {
      "name": "Tables and classes",
      "scope": ["entity.name.type", "support.class", "entity.name.class"],
      "settings": {
        "foreground": "#BCAAD8"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#E6BC9C"
      }
    },
    {
      "name": "Variables and columns",
      "scope": ["variable", "variable.other.property"],
      "settings": {
        "foreground": "#E8E1D3"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#E5877B"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#E5877B"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#E8E1D3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#E8E1D3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#BAC47E"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#8FBAC6"
      }
    }
  ]
}
