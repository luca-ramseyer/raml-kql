  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6E675C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#5A6827"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant", "constant.language"],
      "settings": {
        "foreground": "#8A5418"
      }
    },
    {
      "name": "Keywords and query operators",
      "scope": ["keyword", "keyword.control", "storage"],
      "settings": {
        "foreground": "#9E3B2F"
      }
    },
    {
      "name": "Directives",
      "scope": ["keyword.control.directive", "meta.preprocessor"],
      "settings": {
        "foreground": "#9E3B2F"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#423D37"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#2F5D6B"
      }
    },
    {
      "name": "Types",
      "scope": ["storage.type", "support.type"],
      "settings": {
        "foreground": "#5B4A7A"
      }
    },
    {
      "name": "Tables and classes",
      "scope": ["entity.name.type", "support.class", "entity.name.class"],
      "settings": {
        "foreground": "#5B4A7A"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#7A4E2D"
      }
    },
    {
      "name": "Variables and columns",
      "scope": ["variable", "variable.other.property"],
      "settings": {
        "foreground": "#423D37"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#9E3B2F"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#9E3B2F"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#423D37",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#423D37",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#5A6827"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#2F5D6B"
      }
    }
  ]
}
