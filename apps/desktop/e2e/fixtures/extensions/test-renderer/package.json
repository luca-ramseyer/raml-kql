  "license": "MIT",
  "engines": {
    "raml-kql": "^1.0.0"
  },
  "permissions": [
    {
      "id": "results.read",
      "reason": "Count the result rows"
    }
  ],
  "contributes": {
    "resultRenderers": [
      {
        "id": "rowCounter.view",
        "title": "Row Counter",
        "ui": "dist/ui/rows.html"
      }
    ]
  }
}
